<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ Back"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Add Bed Record"
            android:textColor="?attr/colorOnSurface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Enter weekly hospital bed information"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Week *"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputWeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:hint="Enter week number"
            android:inputType="number"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Month *"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:hint="Enter month (1-12)"
            android:inputType="number"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Service *"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:hint="Enter service"
            android:inputType="textCapWords"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available Beds"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputAvailableBeds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:hint="Enter available beds"
            android:inputType="number"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Patients Request"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputPatientsRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:hint="Enter patients request"
            android:inputType="number"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Patients Admitted"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputPatientsAdmitted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:hint="Enter patients admitted"
            android:inputType="number"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Patients Refused"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputPatientsRefused"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:hint="Enter patients refused"
            android:inputType="number"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Patient Satisfaction"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputPatientSatisfaction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:hint="Enter patient satisfaction"
            android:inputType="number"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Staff Morale"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputStaffMorale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:hint="Enter staff morale"
            android:inputType="number"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:hint="Enter event (optional)"
            android:inputType="textCapSentences"
            android:padding="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Bed Record"
            android:textAllCaps="false"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
